{
    "version": 1,
    "formatters": {
        "default": {
            "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
        },

        "resource_management_format": {
            "format": "System Resources Management - %(asctime)s - %(name)s - %(levelname)s - %(message)s"
        },

        "data_preprocessor_format": {
            "format": "Data Preprocessing Pipeline - %(asctime)s - %(name)s - %(levelname)s - %(message)s"
        },

        "test_suite_format":{
            "format": "Test Suite - %(asctime)s - %(name)s - %(levelname)s - %(message)s"
        }
    },
    "handlers": {
        "console": {
            "class": "logging.StreamHandler",
            "formatter": "default"
        },
        "file": {
            "class": "logging.FileHandler",
            "filename": "default_logs.txt",
            "formatter": "default"
        },
        "resource_management_file": {
            "class": "logging.FileHandler",
            "filename": "resource_logs.txt",
            "formatter": "resource_management_format"
        },
        "data_preprocessor_file":{
            "class": "logging.FileHandler",
            "filename": "data_logs.txt",
            "formatter": "data_preprocessor_format"
        },
        "test_suite_file": {
            "class": "logging.FileHandler",
            "filename": "test_logs.txt",
            "formatter": "test_suite_format"
        }
    },
    "loggers": {
        "main": {
            "level": "INFO",
            "handlers": ["file", "console"],
            "propagate": false
        },
        "resource_management": {
            "level": "INFO",
            "handlers": ["resource_management_file"],
            "propagate": true
        },
        "data_preprocessor":{
            "level": "INFO",
            "handlers": ["data_preprocessor_file"],
            "propagate":true
        },
        "test_suite": {
            "level": "INFO",
            "handlers": ["test_suite_file"],
            "propagate": false
        }
    }
}