{
    "version": 1,
    "formatters": {
        "default": {
            "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
        },

        "resource_management_format": {
            "format": "System Resources Management - %(asctime)s - %(name)s - %(levelname)s - %(message)s"}
    },
    "handlers": {
        "console": {
            "class": "logging.StreamHandler",
            "formatter": "default"
        },
        "file": {
            "class": "logging.FileHandler",
            "filename": "logs.txt",
            "formatter": "default"
        },
        "resource_management_file": {
            "class": "logging.FileHandler",
            "filename": "logs.txt",
            "formatter": "resource_management_format"
        }
    },
    "loggers": {
        "main": {
            "level": "INFO",
            "handlers": ["file", "console"],
            "propagate": false
        },
        "resource_management": {
            "level": "INFO",
            "handlers": ["resource_management_file"],
            "propagate": true
        }
    }
}